<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/resultDisplay"
        android:layout_width="411dp"
        android:layout_height="155dp"
        android:text="@string/result_text"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:gravity="end"
        android:textSize="48sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <GridLayout
        android:id="@+id/buttonGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:columnCount="5"
        android:rowCount="6"
        app:layout_constraintDimensionRatio="H,6:6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button style="@style/CalcButtons" android:text="@string/mc_button" />
        <Button style="@style/CalcButtons" android:text="@string/mr_button" />
        <Button style="@style/CalcButtons" android:text="@string/ms_button" />
        <Button style="@style/CalcButtons" android:text="@string/mplus_button" />
        <Button style="@style/CalcButtons" android:text="@string/m_minus_buton" />

        <Button style="@style/CalcButtons" android:text="@string/backspace_button" android:onClick="onBackspaceClick" />
        <Button style="@style/CalcButtons" android:text="@string/ce_button" />
        <Button style="@style/CalcButtons" android:text="@string/clear_button" android:onClick="onClearClick" />
        <Button style="@style/CalcButtons" android:text="@string/flip_button" android:onClick="onFlipClick"/>
        <Button style="@style/CalcButtons" android:text="@string/sqrt_button" android:onClick="onSqrtClick"/>

        <Button style="@style/CalcButtons" android:text="@string/seven_button" android:onClick="onDigitClick" />
        <Button style="@style/CalcButtons" android:text="@string/eight_button" android:onClick="onDigitClick" />
        <Button style="@style/CalcButtons" android:text="@string/nine_button"  android:onClick="onDigitClick"/>
        <Button style="@style/CalcButtons" android:text="@string/division_button" android:onClick="onOperatorClick" />
        <Button style="@style/CalcButtons" android:text="@string/percent_button" />

        <Button style="@style/CalcButtons" android:text="@string/four_button"  android:onClick="onDigitClick" />
        <Button style="@style/CalcButtons" android:text="@string/five_button" android:onClick="onDigitClick" />
        <Button style="@style/CalcButtons" android:text="@string/six_button" android:onClick="onDigitClick" />
        <Button style="@style/CalcButtons" android:text="@string/multiply_button" android:onClick="onOperatorClick" />
        <Button style="@style/CalcButtons" android:text="@string/kazkoks_button" />

        <Button style="@style/CalcButtons" android:text="@string/one_button" android:onClick="onDigitClick"/>
        <Button style="@style/CalcButtons" android:text="@string/two_button" android:onClick="onDigitClick"/>
        <Button style="@style/CalcButtons" android:text="@string/three_button" android:onClick="onDigitClick"/>
        <Button style="@style/CalcButtons" android:text="@string/minus_button" android:onClick="onOperatorClick"/>

        <Button
            style="@style/CalcButtons"
            android:layout_rowSpan="2"
            android:text="@string/equals_button" android:onClick="onEqualsClick">

        </Button>

        <Button
            style="@style/CalcButtons"
            android:layout_columnSpan="2"
            android:text="@string/zero_button" android:onClick="onDigitClick">

        </Button>

        <Button style="@style/CalcButtons" android:text="@string/seperator_button" android:onClick="onDigitClick" />
        <Button style="@style/CalcButtons" android:text="@string/plus_button" android:onClick="onOperatorClick" />


    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>