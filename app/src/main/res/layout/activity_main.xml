<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/resultDisplay"
        android:layout_width="411dp"
        android:layout_height="155dp"
        android:text="0"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:gravity="end"
        android:textSize="48sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <GridLayout
        android:id="@+id/buttonGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:columnCount="5"
        android:rowCount="6"
        app:layout_constraintDimensionRatio="H,6:6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button style="@style/CalcButtons" android:text="MC" />
        <Button style="@style/CalcButtons" android:text="MR" />
        <Button style="@style/CalcButtons" android:text="MS" />
        <Button style="@style/CalcButtons" android:text="M+" />
        <Button style="@style/CalcButtons" android:text="M-" />

        <Button style="@style/CalcButtons" android:text="←" />
        <Button style="@style/CalcButtons" android:text="CE" />
        <Button style="@style/CalcButtons" android:text="C" />
        <Button style="@style/CalcButtons" android:text="±" />
        <Button style="@style/CalcButtons" android:text="√" />

        <Button style="@style/CalcButtons" android:text="7" />
        <Button style="@style/CalcButtons" android:text="8" />
        <Button style="@style/CalcButtons" android:text="9" />
        <Button style="@style/CalcButtons" android:text="/" />
        <Button style="@style/CalcButtons" android:text="%" />

        <Button style="@style/CalcButtons" android:text="4" />
        <Button style="@style/CalcButtons" android:text="5" />
        <Button style="@style/CalcButtons" android:text="6" />
        <Button style="@style/CalcButtons" android:text="*" />
        <Button style="@style/CalcButtons" android:text="1/x" />

        <Button style="@style/CalcButtons" android:text="1" />
        <Button style="@style/CalcButtons" android:text="2" />
        <Button style="@style/CalcButtons" android:text="3" />
        <Button style="@style/CalcButtons" android:text="-" />

        <Button
            style="@style/CalcButtons"
            android:layout_rowSpan="2"
            android:text="=">

        </Button>

        <Button
            style="@style/CalcButtons"
            android:layout_columnSpan="2"
            android:text="0">

        </Button>

        <Button style="@style/CalcButtons" android:text="." />
        <Button style="@style/CalcButtons" android:text="+" />


    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>